{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @lifegame/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/llm/(.*)", "destination": "/api/llm?path=$1" }
  ],
  "functions": {
    "api/llm.ts": { "maxDuration": 60 }
  }
}
