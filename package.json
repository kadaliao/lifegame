{
  "name": "lifegame",
  "private": true,
  "version": "0.1.0",
  "description": "有真正智能的人生模拟世界",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "vitest run",
    "dev": "pnpm --filter @lifegame/web dev",
    "cli": "pnpm --filter @lifegame/cli start",
    "typecheck": "tsc -b",
    "cli:live": "pnpm --filter @lifegame/cli live"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@8.7.5"
}
